JWT_SECRET=
GEMINI_API_KEY=
GROQ_API_KEY=
RESEND_API_KEY=

# Optional local overrides.
# EMAIL_VERIFICATION_URL=http://localhost:5173/verify-email
# PASSWORD_RESET_URL=http://localhost:5173/reset-password

# Production profile and database connection. Configure these in the hosting
# provider rather than in a committed file.
# SPRING_PROFILES_ACTIVE=prod
# DB_HOST=
# DB_PORT=5432
# DB_NAME=
# DB_USERNAME=
# DB_PASSWORD=

# Production web configuration. These default to studysynapse.app in the prod
# profile and only need setting if the deployed URLs differ.
# FRONTEND_ORIGIN=https://studysynapse.app
# EMAIL_VERIFICATION_URL=https://studysynapse.app/verify-email
# PASSWORD_RESET_URL=https://studysynapse.app/reset-password
# PORT=8080

# Optional JVM settings for a small container.
# JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=65 -XX:InitialRAMPercentage=20 -XX:+UseSerialGC
